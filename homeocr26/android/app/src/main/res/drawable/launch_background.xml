<?xml version="1.0" encoding="utf-8"?>
<!-- Matches Dart splash: gradient + medical badge + title grouped in the center. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@drawable/splash_gradient" />

    <item
        android:width="132dp"
        android:height="132dp"
        android:bottom="40dp"
        android:drawable="@drawable/splash_icon_badge"
        android:gravity="center" />

    <item
        android:width="300dp"
        android:height="72dp"
        android:drawable="@drawable/splash_wordmark"
        android:gravity="center"
        android:top="88dp" />
</layer-list>
